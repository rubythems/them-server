    }
    .gem-version {
      color: #667eea;
      font-weight: 500;
    }
    .gem-meta {
      display: flex;
      gap: 20px;
      color: #666;
      font-size: 14px;
    }
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge.yanked {
      background: #fee;
      color: #c33;
    }
    .badge.active {
      background: #efe;
      color: #3c3;
    }
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #999;
    }
    .empty-state svg {
      width: 80px;
      height: 80px;
      margin-bottom: 20px;
      opacity: 0.3;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>💎 Them Server Dashboard</h1>
    <div class="user-info">
      <span><%= user_name %> (<%= user_email %>)</span>
      <a href="/auth/logout" class="logout-btn">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="stats">
      <div class="stat-card">
        <h3>Total Gems</h3>
        <div class="value"><%= gem_count %></div>
      </div>
      <div class="stat-card">
        <h3>Active Gems</h3>
        <div class="value"><%= gems.count { |g| !g[:yanked] } %></div>
      </div>
      <div class="stat-card">
        <h3>Yanked Gems</h3>
        <div class="value"><%= gems.count { |g| g[:yanked] } %></div>
      </div>
    </div>

    <div class="gems-section">
      <h2>Your Gems</h2>

      <% if gems.empty? %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <h3>No gems yet</h3>
          <p>Push your first gem to get started!</p>
        </div>
      <% else %>
        <div class="gem-list">
          <% gems.each do |gem| %>
            <div class="gem-item">
              <div class="gem-header">
                <div>
                  <div class="gem-name">
                    <% if gem[:scope_path] %>
                      <%= gem[:scope_path] %>/<%= gem[:name] %>
                    <% else %>
                      <%= gem[:name] %>
                    <% end %>
                  </div>
                  <div class="gem-version">v<%= gem[:version] %></div>
                </div>
                <span class="badge <%= gem[:yanked] ? 'yanked' : 'active' %>">
                  <%= gem[:yanked] ? 'Yanked' : 'Active' %>
                </span>
              </div>
              <div class="gem-meta">
                <span>📅 <%= gem[:created_at].strftime('%Y-%m-%d %H:%M') rescue 'N/A' %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
