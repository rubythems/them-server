#!/usr/bin/env ruby
# frozen_string_literal: true

puts "Testing Rodauth Authentication..."
puts "=" * 60

require "net/http"
require "uri"

host = ENV.fetch("HOST", "127.0.0.1")
port = ENV.fetch("PORT", "9292")
base = "http://#{host}:#{port}"

begin
  uri = URI.parse("#{base}/auth/login")
  res = Net::HTTP.get_response(uri)
  if res.is_a?(Net::HTTPSuccess) || res.is_a?(Net::HTTPRedirection)
    puts "\n\u2713 Rodauth login page accessible at #{uri}"
  else
    puts "\n\u2717 Failed to load login page (status #{res.code})"
  end
rescue => e
  puts "\n\u2717 Error fetching login page: #{e.message}"
end

puts "\nRoutes to try:"
puts "  - Login:      #{base}/auth/login"
puts "  - Create:     #{base}/auth/create-account"
puts "  - Dashboard:  #{base}/auth/dashboard (after login)"
puts "  - Logout:     #{base}/auth/logout"
puts "\nDone."
